// ====================================================================
// firestore.rules
// Firestore security rules for the
// "Seniors Teach, Juniors Reach" registration site
//
// Apply via: Firebase Console -> Firestore -> Rules
// Or deploy with: firebase deploy --only firestore:rules
// ====================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---------- PUBLIC REGISTRATIONS ----------
    //
    // Public users (NOT signed in) may:
    //   - create a registration document
    //
    // They may NOT:
    //   - read all registrations
    //   - update existing registrations
    //   - delete registrations
    //
    // The create rule validates the document shape to make sure
    // users can't write arbitrary fields or spoof registration IDs.
    match /registrations/{registrationId} {

      // Allow create for unauthenticated users
      // OR for signed-in admins (so the admin UI can also add records).
      //
      // IMPORTANT: the incoming document's `registrationId` field must
      // match the document ID in the path so users cannot forge IDs.
      allow create: if
        // Required fields present
        request.resource.data.keys().hasAll([
          'registrationId', 'fullName', 'rollNumber', 'department',
          'year', 'email', 'mobile', 'gender', 'interests',
          'workshopTopic', 'status', 'createdAt'
        ]) &&
        // Field types
        request.resource.data.fullName      is string &&
        request.resource.data.rollNumber    is string &&
        request.resource.data.department    is string &&
        request.resource.data.year          is string &&
        request.resource.data.email         is string &&
        request.resource.data.mobile        is string &&
        request.resource.data.gender        is string &&
        request.resource.data.interests     is string &&
        request.resource.data.workshopTopic is string &&
        request.resource.data.status        is string &&
        request.resource.data.registrationId is string &&
        // ID in payload must match the document ID in the path
        request.resource.data.registrationId == registrationId &&
        request.resource.data.status == "registered" &&
        // Length sanity checks
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 200 &&
        request.resource.data.email.size()    >= 5 &&
        request.resource.data.email.size()    <= 200 &&
        request.resource.data.mobile.size()   >= 10 &&
        request.resource.data.mobile.size()   <= 20 &&
        // createdAt is a serverTimestamp() — it resolves to a real
        // Timestamp server-side. We don't type-check it because some
        // SDK versions pass the sentinel at rule-evaluation time.
        request.resource.data.createdAt != null;

      // Admins can read everything; everyone else cannot.
      allow read: if isAdmin();

      // No public updates; admins may update (e.g. to mark attended)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ---------- COUNTERS (used to generate sequential registration IDs) ----------
    //
    // The transaction in registration.js reads & writes the counter.
    // Public read+write is allowed because the counter is not sensitive
    // — it only stores a monotonically increasing number.
    // If you want to lock this down, restrict the write to admins and
    // run the counter increment from a trusted server function instead.
    match /metadata/{doc} {
      allow read, write: if true;
    }

    // ---------- ADMIN-ONLY DATA ----------
    //
    // Any other collection requires the admin custom claim.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
